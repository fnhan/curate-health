# Warning: Do not add secrets (API keys and similar) to this file, as it source controlled!
# Use `.env.local` for any secrets, and ensure it is not added to source control
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=
SANITY_API_READ_TOKEN=

# Shared secret for the Sanity revalidation webhook at /api/revalidate.
# Must match the Secret field on the webhook in sanity.io/manage. Without it
# the endpoint refuses every delivery. See CH-026.
SANITY_REVALIDATE_SECRET=

PASSWORD_COOKIE_NAME=
PASSWORD_SEARCH_QUERY_NAME=
PAGE_PASSWORD=
