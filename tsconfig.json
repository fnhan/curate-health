{
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    // scripts/test-share-fallback.ts imports lib/page-metadata.ts by its real
    // filename, because Node runs it directly with type stripping and its ESM
    // resolver needs the extension. Safe here only because noEmit is on: tsc
    // never writes the import out, so nothing ships a .ts specifier.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    // "bundler", not "node". Sanity 6 and next-sanity 13 declare their
    // subpaths through "exports", which node10 resolution cannot read, so
    // every `sanity/structure` and `next-sanity/studio` import fails to
    // typecheck under it. This is a compiler setting only: Next and
    // Turbopack do their own resolution, so nothing about the built output
    // changes.
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "/*.tsx",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
